GEMINI_API_KEY=
# Vertex AI を使う場合（設定すると作曲と Gemini は Vertex を使う。手元では gcloud auth の認証を使う）
# VERTEX_PROJECT=dev-fast-deadline-driven
# サイト全体にパスワード（Basic 認証）をかける場合
# APP_PASSWORD=

# Optional CPU transcription server
MUSCRIPTOR_URL=http://127.0.0.1:8222
# Private A100 tunnel created by npm run a100
MUSCRIPTOR_A100_URL=http://127.0.0.1:8223
