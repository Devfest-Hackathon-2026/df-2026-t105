{
  "name": "ghostnotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "make-demo": "node --env-file=.env scripts/make-demo.mjs",
    "doc-page": "node scripts/doc-page/build.mjs docs/経緯と設計.md out/ghostnotes-design.html",
    "a100": "node scripts/a100.mjs",
    "compare:prepare": "node scripts/prepare-comparison.mjs",
    "compare:serve": "python3 -m http.server 8899 --bind 127.0.0.1 --directory public/compare"
  },
  "dependencies": {
    "spessasynth_core": "^4.4.8",
    "spessasynth_lib": "^4.4.6",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@google/genai": "^2.25.0",
    "@spotify/basic-pitch": "^1.0.1",
    "@tensorflow/tfjs": "^4.22.0",
    "marked": "^14.1.0",
    "playwright": "^1.58.2",
    "tone": "^15.1.22",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
